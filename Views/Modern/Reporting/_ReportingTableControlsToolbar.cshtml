@* Zoom and full-width controls for modern reporting tables (monthly report, risks by tier, etc.). *@
<div class="mr-report-table-toolbar raid-spreadsheet-toolbar govuk-!-margin-bottom-0" role="toolbar" aria-label="Table display options">
  <div class="raid-ss-toolbar-actions">
    <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 raid-ss-btn-icon mr-report-zoom-out-btn" data-module="govuk-button" title="Zoom out" aria-label="Zoom out">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
    </button>
    <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 raid-ss-btn-icon mr-report-zoom-in-btn" data-module="govuk-button" title="Zoom in" aria-label="Zoom in">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
    </button>
    <button type="button" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0 raid-ss-btn-icon mr-report-zoom-reset-btn" data-module="govuk-button" title="Reset zoom" aria-label="Reset zoom">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
    </button>
    <button type="button" class="govuk-button govuk-!-margin-bottom-0 mr-report-table-fullscreen-btn" data-module="govuk-button">
      <span class="btn-fs-expand">Expand table</span>
      <span class="btn-fs-collapse" style="display:none">Exit full width</span>
    </button>
  </div>
</div>
